ENV=development

JWT_SECRET_KEY=change-this-in-production
ALGORITHM=HS256

# Points at docker-compose.test.yml's disposable Postgres by default — start it with
# `docker compose -f docker-compose.test.yml up -d` and these values work as-is.
# Swap in your own Postgres (or RDS) credentials for anything beyond local dev.
DB_USERNAME=test
DB_PASSWORD=test
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auth_test

# Optional locally: if SMTP_HOST is unset, reset/verification links are logged
# server-side instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email

# Encrypts TOTP secrets at rest. Has an insecure hardcoded default for local dev
# (see core/config.py) — set a real Fernet key (Fernet.generate_key()) in production.
MFA_ENCRYPTION_KEY=
