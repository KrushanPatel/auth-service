ENV=development

JWT_SECRET_KEY=change-this-in-production
ALGORITHM=HS256

# Points at docker-compose.test.yml's disposable Postgres by default — start it with
# `docker compose -f docker-compose.test.yml up -d` and these values work as-is.
# Swap in your own Postgres (or RDS) credentials for anything beyond local dev.
DB_USERNAME=test
DB_PASSWORD=test
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auth_test
# The local Postgres has no TLS. Leave DB_SSL unset in production (defaults to "require").
DB_SSL=disable

# Optional locally: if SMTP_HOST is unset, reset/verification links are logged
# server-side instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email

# Encrypts TOTP secrets at rest. Has an insecure hardcoded default for local dev
# (see core/config.py) — set a real Fernet key (Fernet.generate_key()) in production.
MFA_ENCRYPTION_KEY=

# "Sign in with Google" — create an OAuth client at
# https://console.cloud.google.com/apis/credentials and register GOOGLE_REDIRECT_URI
# as an authorized redirect URI. Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Backs rate limiting. docker-compose.yml overrides this to redis://redis:6379/0
# for the containerized app; this default targets a locally-run Redis instead.
REDIS_URL=redis://localhost:6379/0
